/* =========================================================
   全局现代化样式表 (Modern UI Stylesheet)
   色彩规范:
   - 全局背景: #f4f7fb (浅蓝偏灰)
   - 卡片背景: #ffffff (纯白)
   - 文本色: #0f172a (主标题黑), #475569 (正文深灰), #64748b (辅助浅灰)
   - 边框色: #e2e8f0 (主边框), #f1f5f9 (内网格修饰)
   - 主色调: #3b82f6 (明亮蓝)
========================================================= */

/* --- 1. 全局背景与字体 --- */
QMainWindow {
    background-color: #f4f7fb;
}

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "Inter", sans-serif;
    color: #0f172a;
}

/* 顶部状态栏紧凑卡片 */
QFrame#DashboardCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* 分组框 (GroupBox) 紧凑无过多冗余留白 */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
    font-size: 13px;
    color: #334155;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background-color: #f4f7fb;
    color: #475569;
}

/* --- 2. 按钮 (Buttons) --- */
QPushButton {
    background-color: #ffffff;
    color: #3b82f6;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #eff6ff;
    border: 1px solid #93c5fd;
}
QPushButton:pressed {
    background-color: #dbeafe;
}
QPushButton:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}

/* --- 3. 文本输入框与下拉框 (LineEdits & ComboBoxes) --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 8px;
    color: #0f172a;
    selection-background-color: #bfdbfe;
    min-height: 20px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QTimeEdit:hover {
    border: 1px solid #94a3b8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    width: 0px; 
}
QComboBox QAbstractItemView {
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background-color: #ffffff;
    selection-background-color: #f1f5f9;
    selection-color: #0f172a;
    outline: none;
}

/* --- 4. 标签页 (TabWidget & TabBar) 解决文字半截腰斩与空间挤压 --- */
QTabWidget::pane {
    border: 0px; 
    border-top: 1px solid #e2e8f0;
    background-color: transparent; 
}

QTabBar {
    qproperty-drawBase: 0;
    background-color: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: bold;
}

QTabBar::tab {
    background-color: transparent;
    color: #64748b;
    padding: 8px 18px 8px 18px;
    border-bottom: 3px solid transparent;
    margin-right: 6px;
}

QTabBar::tab:selected {
    color: #3b82f6;
    border-bottom: 3px solid #3b82f6;
}

QTabBar::tab:hover:!selected {
    color: #0f172a;
    border-bottom: 3px solid #cbd5e1;
}

/* --- 5. 表格与树形视图 (TableView & TreeView) --- */
QTableView, QTreeView, QListView, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #0f172a;
    alternate-background-color: #f8fafc;
    outline: none;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 4px 4px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    font-weight: 600;
    font-size: 12px;
    text-align: left;
}

QHeaderView::section:horizontal {
    border-right: 1px solid #f1f5f9;
}
QHeaderView::section:horizontal:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
}

/* --- 6. 滚动条 (ScrollBar) --- */
QScrollBar:vertical {
    border: none;
    background: #f8fafc;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #f8fafc;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* --- 7. 紧凑型仪表盘统计卡片文本 --- */
QLabel#DashValueLabel {
    color: #0f172a;
    font-size: 20px;
    font-weight: bold;
}
QLabel#DashTitleLabel {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}
QLabel#DashIconLabel {
    padding: 4px;
    border-radius: 6px;
    background-color: #f1f5f9;
}

/* 底部时钟条 */
QLabel#BottomClock {
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
    padding: 2px 0px;
}
